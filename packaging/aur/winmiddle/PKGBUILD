# Maintainer: eslachance <eslachance@users.noreply.github.com>
pkgname=winmiddle
pkgver=0.2.2
pkgrel=1
pkgdesc="Windows-faithful middle-click autoscroll for Linux (Plasma/Wayland)"
arch=('x86_64')
url="https://github.com/eslachance/winmiddle"
license=('MIT')
depends=(
  'python'
  'python-evdev'
  'python-pyqt6'
  'layer-shell-qt'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-wheel'
  'python-hatchling'
  'cmake'
  'kwin'
)
optdepends=(
  'kwin: focus/cursor helper script + cursor-hiding effect (recommended on Plasma)'
  'python-gobject: AT-SPI scrollable-under-cursor probing'
  'at-spi2-core: accessibility bus for scroll probing'
)
install=winmiddle.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('2615bd4c808fc66ff5ab883fb9b6c7b7a6883fb8320ce54c9cca3f205e1175bf')

build() {
  cd "$srcdir/winmiddle-$pkgver"
  python -m build --wheel --no-isolation
  # KWin effect: hides the real pointer while autoscroll pins it. Tied to the
  # exact KWin version (KWin skips it after an upgrade) — rebuild this package then.
  cmake -S kwin-effect -B build-effect -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build-effect
}

package() {
  cd "$srcdir/winmiddle-$pkgver"
  python -m installer --destdir="$pkgdir" --prefix=/usr dist/*.whl
  bash packaging/install-data.sh "$pkgdir"
  DESTDIR="$pkgdir" cmake --install build-effect
}
